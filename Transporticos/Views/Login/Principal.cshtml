@{
    // Establecemos el título de la página
    ViewData["Title"] = "Menú Principal de Transporticos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mt-4">Bienvenidos a Transporticos</h1>
            <p>Aquí va el contenido principal de tu menú o dashboard.</p>
            <hr />

            <!-- Cards -->
            <div class="row">
                <div class="col-md-4">
                    <div class="card text-bg-info mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Estudiantes</h5>
                            <p class="card-text">Gestión de rutas, horarios y estudiantes registrados.</p>
                            <a href="#" class="btn btn-primary" role="button">Ver detalles</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-bg-info mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Turismo</h5>
                            <p class="card-text">Paquetes turísticos y gestión de reservas.</p>
                            <a href="#" class="btn btn-primary" role="button">Ver detalles</a>
                        </div>
                    </div>
                </div>
                <!-- Agregar más secciones o cards según funcionalidades -->
            </div>
        </div>
    </div>
</div>
