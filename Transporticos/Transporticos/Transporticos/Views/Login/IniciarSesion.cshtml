@model SM_ProyectoWeb.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="d-flex flex-column justify-content-center">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-10">
                <div class="card card-default mb-0">
                    <div class="card-header pb-0">
                        <div class="app-brand w-100 d-flex justify-content-center border-bottom-0">
                            <a class="w-auto pl-0" href="@Url.Action("Index", "Home")">
                                <img src="~/img/logoBus.png" alt="Mono" />
                                <span class="brand-name text-dark">TRANSPORTICOS</span>
                            </a>
                        </div>
                    </div>
                    <div class="card-body px-5 pb-5 pt-0">
                        <h4 class="text-dark mb-6 text-center">Iniciar Sesión</h4>

                        <!-- Formulario con Tag Helpers -->
                        <form asp-action="IniciarSesion" asp-controller="Login" method="post">
                            @Html.AntiForgeryToken()

                            <div class="row">
                                <!-- IDENTIFICACION -->
                                <div class="form-group col-md-12 mb-4">
                                    <label asp-for="Identificacion"></label>
                                    <input asp-for="Identificacion" class="form-control input-lg" placeholder="Identificación" />
                                    <span asp-validation-for="Identificacion" class="text-danger"></span>
                                </div>

                                <!-- CONTRASEÑA -->
                                <div class="form-group col-md-12 mb-4">
                                    <label asp-for="Contraseña"></label>
                                    <input asp-for="Contraseña" class="form-control input-lg" placeholder="Contraseña" />
                                    <span asp-validation-for="Contraseña" class="text-danger"></span>
                                </div>

                                <!-- BOTÓN DE PROCESAR / LOGIN -->
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-primary btn-pill mb-4">Procesar</button>

                                    <p>
                                        ¿No tienes una cuenta?
                                        <a class="text-blue" href="sign-up.html">Regístrate</a>
                                    </p>

                                    <div class="d-flex justify-content-between mb-3">
                                        <a class="text-color" href="#">¿Recuperar Contraseña?</a>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <!-- FIN FORMULARIO -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
